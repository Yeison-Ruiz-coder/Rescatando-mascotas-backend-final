# ========== DIRECTORIOS DEL SISTEMA ==========
/.phpunit.cache
/node_modules
/vendor
/.fleet
/.idea
/.vscode

# ========== BUILD Y ASSETS ==========
/public/build
/public/hot
/public/storage

# ========== LOGS (IGNORAR - NO SUBIR) ==========
/storage/*.log
/storage/logs/*.log
/storage/logs/laravel.log
/storage/framework/cache/*.php
/storage/framework/sessions/*.php
/storage/framework/views/*.php
/storage/framework/testing/*.php
logs/
*.log
*.log.[0-9]

# ========== ARCHIVOS DE ENTORNO (NO SUBIR) ==========
.env
.env.backup
.env.production
.env.local
.env.testing

# ========== ARCHIVOS DE DEPENDENCIAS ==========
# NOTA: composer.lock y package-lock.json DEBEN subirse a Git
# No los ignores
auth.json

# ========== ARCHIVOS DE PRUEBAS ==========
.phpunit.result.cache
Homestead.json
Homestead.yaml

# ========== LOGS DE ERRORES ==========
npm-debug.log
yarn-error.log

# ========== ARCHIVOS DEL SISTEMA ==========
.DS_Store
Thumbs.db
.dockerignore

# ========== IMÁGENES DEL SISTEMA (DISEÑO) ==========
# Estas SÍ se suben a Git porque son parte del código
!public/img/
!public/img/**/*.jpg
!public/img/**/*.png
!public/img/**/*.jpeg
!public/img/**/*.webp
!public/img/**/*.gif

# ========== SUBIDAS DE USUARIOS - NO SUBIR A GIT ==========
# Estos son datos, no código. Van a Cloudinary
public/uploads/
storage/app/public/
