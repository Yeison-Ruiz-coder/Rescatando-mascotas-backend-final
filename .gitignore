# ========== ARCHIVOS DE ENTORNO (NUNCA SUBIR) ==========
.env
.env.backup
.env.production
.env.local
.env.testing

# ========== DEPENDENCIAS (NO SUBIR) ==========
/vendor
/node_modules

# =========️ CACHE DE LARAVEL (IGNORAR CONTENIDO, PERO MANTENER CARPETAS) ==========
/storage/*.key
/storage/*.log
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/bootstrap/cache/

# ========== ARCHIVOS DE BUILD Y ASSETS TEMPORALES ==========
/public/build
/public/hot
/public/storage

# ========== ARCHIVOS DE LOGS ==========
*.log
npm-debug.log
yarn-error.log

# ========== ARCHIVOS DEL SISTEMA ==========
.DS_Store
Thumbs.db
/.idea
/.vscode
/.fleet
/.phpunit.cache
.phpunit.result.cache

# ========== HOMESTEAD / ENTORNO LOCAL ==========
Homestead.json
Homestead.yaml

# ========== COMPOSER ==========
composer.phar
auth.json

# ========== ARCHIVOS OPCIONALES (SEGÚN TU FLUJO) ==========
# Si usas Laravel Sail
/sail

# Si usas Laravel Telescope
/telescope

# ========== ¡IMPORTANTE! MANTENER LAS CARPETAS DE STORAGE ==========
# Esto evita que Git borre las carpetas vacías necesarias para Laravel
!storage/app/
!storage/framework/
!storage/framework/cache/
!storage/framework/sessions/
!storage/framework/testing/
!storage/framework/views/
!storage/logs/
!bootstrap/cache/
