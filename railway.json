{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "phpVersion": "8.3"
    }
  },
  "deploy": {
    "startCommand": "php artisan serve --host=0.0.0.0 --port=${PORT:-8000}",
    "preDeployCommand": "php artisan migrate --force",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}